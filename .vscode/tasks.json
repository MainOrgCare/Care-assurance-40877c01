{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Dev Server",
      "type": "shell",
      "command": "npm run dev",
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Build",
      "type": "shell",
      "command": "npm run build",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Import ACP Service Users",
      "type": "shell",
      "command": "npm",
      "args": [
        "run",
        "import:acp-service-users",
        "--",
        "${input:acpWorkbookPath}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "acpWorkbookPath",
      "type": "promptString",
      "description": "Absolute path to the ACP workbook or CSV file to import",
      "default": "/workspaces/Care-assurance-40877c01/dist/newcastle_service_users_CLEANED 2.csv"
    }
  ]
}
