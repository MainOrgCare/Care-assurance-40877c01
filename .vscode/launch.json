{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Dev Server",
            "skipFiles": ["<node_internals>/**"],
            "runtimeExecutable": "npx",
            "runtimeArgs": ["tsx", "server/index.ts"],
            "env": { "NODE_ENV": "development" },
            "console": "integratedTerminal"
        }
    ]
}