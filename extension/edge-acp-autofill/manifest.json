{
  "manifest_version": 3,
  "name": "Care Assurance ACP Autofill",
  "version": "0.1.1",
  "description": "Autofill Access Care Planning risk assessments from Care Assurance.",
  "action": {
    "default_title": "ACP Autofill",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://clece.mobizio.com/*",
    "https://careassurance.uk/*",
    "https://www.careassurance.uk/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://careassurance.uk/*",
        "https://www.careassurance.uk/*"
      ],
      "js": [
        "constants.js",
        "content-app.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://clece.mobizio.com/*"
      ],
      "js": [
        "constants.js",
        "content-acp.js",
        "content-emar.js",
        "content-generic.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
