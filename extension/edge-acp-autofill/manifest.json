{
  "manifest_version": 3,
  "name": "Care Assurance ACP Autofill",
  "version": "0.6.47",
  "description": "Autofill Access Care Planning forms from Care Assurance risk, care plan, and initial assessment data.",
  "action": {
    "default_title": "ACP Autofill",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "tabs",
    "windows",
    "scripting",
    "cookies"
  ],
  "host_permissions": [
    "https://clece.mobizio.com/*",
    "https://careassurance.uk/*",
    "https://www.careassurance.uk/*",
    "https://*.onrender.com/*",
    "http://localhost:*/*",
    "http://127.0.0.1:*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://careassurance.uk/*",
        "https://www.careassurance.uk/*",
        "https://*.onrender.com/*",
        "http://localhost:*/*",
        "http://127.0.0.1:*/*"
      ],
      "js": [
        "constants.js",
        "content-bootstrap.js",
        "content-app.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://clece.mobizio.com/*"
      ],
      "js": [
        "constants.js",
        "content-bootstrap.js",
        "realistic-typing.js",
        "content-acp.js",
        "content-initial-assessment.js",
        "content-emar.js",
        "content-generic.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
