{
  "manifest_version": 3,
  "name": "Care Assurance ACP Autofill",
  "version": "0.1.0",
  "description": "Autofill Access Care Planning risk assessments from Care Assurance.",
  "action": {
    "default_title": "ACP Autofill",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "tabs", "activeTab", "scripting"],
  "host_permissions": [
    "https://clece.mobizio.com/*",
    "https://careassurance.uk/*",
    "https://www.careassurance.uk/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://careassurance.uk/*", "https://www.careassurance.uk/*"],
      "js": ["constants.js", "content-app.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://clece.mobizio.com/*"],
      "js": ["constants.js", "content-acp.js"],
      "run_at": "document_idle"
    }
  ]
}
