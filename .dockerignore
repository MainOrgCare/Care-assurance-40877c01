# ── CareAssurance Docker Ignore ─────────────────────────────────────────
# Exclude files not needed in the Docker build context.

# Dependencies (will be installed fresh inside container)
node_modules/
.npm

# Build output (will be generated inside container)
dist/

# Version control
.git/
.gitignore

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Environment (secrets must not be baked into images)
.env
.env.*
!.env.example

# Documentation & non-essential files
*.md
!README.md
docs/
attached_assets/
backups/

# Tests
**/__tests__/
vitest.config.ts
*.test.ts
*.spec.ts
coverage/

# Local LLM
Dockerfile.localllm

# Scripts not needed at runtime
script/
demo-plan-enhancer-output.sh
test-plan-enhancer.*
check-ai-status.sh
enable-rule-based.sh

# Extension source (packaged separately)
extension/

# Copilot agent development
foundry-agent-render/
Microsoft 365 Copilot Agent/
