# ==============================================================================
# Care Assurance Platform — Environment Configuration
# ==============================================================================
# Copy this file to `.env` and fill in the values for your environment.
#   cp .env.example .env
#
# Values marked [REQUIRED] must be set in production.
# Values marked [OPTIONAL] have sensible defaults.
# ==============================================================================

# ─── Runtime ──────────────────────────────────────────────────────────────────
# "development" or "production"
NODE_ENV=development

# Port the HTTP server binds to (Render sets this automatically)
# [OPTIONAL] Default: 5000
PORT=5000

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string
# [REQUIRED in production]
DATABASE_URL=postgresql://user:password@localhost:5432/care_assurance

# ─── Session & Auth ───────────────────────────────────────────────────────────
# Secret used to sign session cookies — use a long random string
# [REQUIRED in production]
SESSION_SECRET=change-me-to-a-random-string

# Admin bootstrap credentials (first-run only — creates the initial admin user)
# [OPTIONAL] Defaults to "Lewis.barron" / "testtest" in development
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=

# ─── Domain & CORS ───────────────────────────────────────────────────────────
# Canonical production domain (used for HSTS, redirects, CORS allow-list)
# [OPTIONAL] Default: careassurance.uk
CANONICAL_DOMAIN=careassurance.uk

# Enable 301 redirect from non-canonical hosts to CANONICAL_DOMAIN
# [OPTIONAL] Default: false
ENABLE_CANONICAL_REDIRECT=false

# Comma-separated list of allowed CORS origins (overrides defaults in production)
# [OPTIONAL] Defaults to https://<CANONICAL_DOMAIN>
CORS_ORIGIN=

# Log CORS origin decisions — useful for debugging
# [OPTIONAL] Default: false
CORS_DEBUG=false

# ─── AI Services ──────────────────────────────────────────────────────────────
# Master toggle — set to "false" to disable all AI features
# [OPTIONAL] Default: true
AI_ENABLED=true

# Preferred AI provider: "openai" | "github" | "local"
# [OPTIONAL] Configured at runtime via admin panel; this sets the default
AI_PROVIDER=openai

# OpenAI API key (required when AI_PROVIDER=openai)
OPENAI_API_KEY=

# GitHub Personal Access Token (required when AI_PROVIDER=github)
# Must have "models" scope for GitHub Models access
GITHUB_TOKEN=

# Local LLM endpoint (Ollama-compatible, used when AI_PROVIDER=local)
# [OPTIONAL] Default: http://localhost:11434
LOCAL_LLM_URL=http://localhost:11434
LOCAL_LLM_MODEL=qwen2.5-64k

# ─── File Scanning ────────────────────────────────────────────────────────────
# Cloudmersive Virus Scan API key (optional — uploads are accepted without it)
CLOUDMERSIVE_API_KEY=

# ─── Render.com Deployment ────────────────────────────────────────────────────
# Set automatically by Render — do not override manually
# RENDER_EXTERNAL_HOSTNAME=

# Serve pre-built static assets in production instead of Vite dev server
# [OPTIONAL] Default: false (set to "true" in Render service config)
SERVE_STATIC=false
