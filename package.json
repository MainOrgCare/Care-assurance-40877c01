{
  "name": "care-assurance",
  "version": "1.0.0",
  "description": "Operational intelligence platform for domiciliary care providers â€” compliance, rostering, AI-assisted care planning, and workforce management.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/postinstall.cjs",
    "dev:client": "npx vite dev --port 5173",
    "dev:server": "NODE_ENV=development AI_ENABLED=${AI_ENABLED:-true} tsx server/index.ts",
    "dev": "npx concurrently -k -n client,server -c cyan,magenta \"npm:dev:client\" \"npm:dev:server\"",
    "dev:full": "set -a; [ -f .env ] && . ./.env; set +a; npx concurrently -k -n client,server -c cyan,magenta \"npm:dev:client\" \"npm:dev:server\"",
    "dev:setup": "npm install && npm run build && npm run dev:full",
    "build:client": "npx vite build",
    "build:server": "npx esbuild server/index.ts --bundle --platform=node --packages=external --format=cjs --outfile=dist/index.cjs --external:./vite.config --external:./vite",
    "build:worker": "npx esbuild server/worker.ts --bundle --platform=node --packages=external --format=cjs --outfile=dist/worker.cjs",
    "build": "npm run build:client && npm run build:server && npm run build:worker",
    "start:api": "NODE_ENV=production AI_ENABLED=${AI_ENABLED:-true} node dist/index.cjs",
    "start:worker": "NODE_ENV=production node dist/worker.cjs",
    "start": "npm run start:api",
    "test": "npm run test:server && npm run test:client",
    "test:server": "node --import tsx --test --test-force-exit server/__tests__/*.test.ts",
    "test:server:emar": "node --import tsx --test --test-force-exit server/__tests__/emarComplianceParity.test.ts",
    "test:server:emar:artifacts": "node --import tsx --test --test-force-exit server/__tests__/emarComplianceArtifacts.test.ts",
    "test:client": "npx vitest run client/src/lib/__tests__",
    "test:client:watch": "npx vitest client/src/lib/__tests__",
    "check": "tsc",
    "quality": "npm run test && npm run check && npm run build",
    "audit:prod": "npm audit --omit=dev",
    "db:push": "drizzle-kit push"
  },
