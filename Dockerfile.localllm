# Local LLM Service using Ollama with Qwen 2.5 7B
# 128K context window for large risk assessments

FROM ollama/ollama:latest

# Set the host to listen on all interfaces
ENV OLLAMA_HOST=0.0.0.0:11434
ENV OLLAMA_KEEP_ALIVE=24h
ENV OLLAMA_NUM_PARALLEL=2
ENV OLLAMA_MAX_LOADED_MODELS=1
# Use persistent storage for models (mounted at /ollama-data on Render)
ENV OLLAMA_MODELS=/ollama-data/models

# Expose the default Ollama port
EXPOSE 11434

# Create a startup script that pulls the model and serves
RUN echo '#!/bin/bash\n\
set -e\n\
\n\
# Ensure persistent models directory exists\n\
mkdir -p /ollama-data/models\n\
\n\
# Start Ollama in the background\n\
ollama serve &\n\
OLLAMA_PID=$!\n\
\n\
# Wait for Ollama to be ready\n\
echo "Waiting for Ollama to start..."\n\
for i in {1..30}; do\n\
  if curl -s http://localhost:11434/api/tags > /dev/null 2>&1; then\n\
    echo "Ollama is ready!"\n\
    break\n\
  fi\n\
  sleep 1\n\
done\n\
\n\
# Check if custom model with 64K context exists\n\
if ! ollama list | grep -q "qwen2.5-64k"; then\n\
  echo "Setting up qwen2.5-64k model with 64K context..."\n\
  \n\
  # Pull base model if needed\n\
  if ! ollama list | grep -q "qwen2.5:7b"; then\n\
    echo "Pulling qwen2.5:7b base model (~4.7GB download)..."\n\
    ollama pull qwen2.5:7b\n\
  fi\n\
  \n\
  # Create Modelfile with 64K context\n\
  echo "FROM qwen2.5:7b" > /tmp/Modelfile\n\
  echo "PARAMETER num_ctx 65536" >> /tmp/Modelfile\n\
  echo "PARAMETER temperature 0" >> /tmp/Modelfile\n\
  \n\
  # Create custom model\n\
  echo "Creating qwen2.5-64k custom model..."\n\
  ollama create qwen2.5-64k -f /tmp/Modelfile\n\
  echo "Model created successfully!"\n\
else\n\
  echo "Model qwen2.5-64k already exists!"\n\
fi\n\
\n\
# Keep the server running\n\
wait $OLLAMA_PID\n\
' > /start.sh && chmod +x /start.sh

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=180s --retries=3 \
  CMD curl -f http://localhost:11434/api/tags || exit 1

# Override entrypoint to use our startup script
ENTRYPOINT []
CMD ["/bin/bash", "/start.sh"]
